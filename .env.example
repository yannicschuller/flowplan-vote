# Public https address (OAuth callback, Origin check, Secure cookies).
VOTE_URL=
# Where the SQLite database lives (the Docker image uses /app/data).
VOTE_DATA_DIR=
# Who may vote: GitHub logins, comma-separated, case-insensitive (list mode),
# or * for everyone with a GitHub account (open mode). Empty = nobody.
VOTE_ALLOWED_LOGINS=
# Logins that may never vote, in either mode (comma-separated, case-insensitive).
VOTE_BLOCKED_LOGINS=
# Open mode only: minimum age of a GitHub account in days (default 30, 0 = off).
VOTE_MIN_ACCOUNT_AGE_DAYS=
# The GitHub App's user authorization (README "GitHub App"): sign-in only.
VOTE_GITHUB_CLIENT_ID=
VOTE_GITHUB_CLIENT_SECRET=
# Bearer token for flowplan-admin (at least 24 characters, e.g. `openssl rand -hex 32`).
# Unset: the admin API answers 404.
VOTE_ADMIN_TOKEN=
# The UI gallery (default https://gallery.flowplan.org).
GALLERY_URL=
# Port of the server (default 3000).
PORT=
# Time zone for dates on the pages and in the prompt (IANA name, default Europe/Berlin).
VOTE_TIME_ZONE=
